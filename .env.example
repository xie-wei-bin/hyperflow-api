# 博客系统环境变量模板
# 复制此文件为 .env 并填入实际配置

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=blog_system

# Redis（密码由 docker-compose 注入，或手动设置）
# 格式：redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-string

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# 日志
LOG_LEVEL=INFO
ENVIRONMENT=production
# development → ConsoleRenderer 彩色输出
# staging     → JSONRenderer 机器解析
# production  → JSONRenderer 机器解析
