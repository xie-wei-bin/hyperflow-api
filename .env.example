# 博客系统环境变量模板
# 复制此文件为 .env 并填入实际配置

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=blog_system

# Redis（密码由 docker-compose 注入，或手动设置）
# 格式：redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-string

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# 日志
LOG_LEVEL=INFO
ENVIRONMENT=production
LOG_FILE_ENABLED=True
LOG_FILE=logs/app.log
LOG_FILE_MAX_BYTES=52428800    # 50MB 单文件上限
LOG_FILE_BACKUP_COUNT=10       # 保留最近 10 个滚动文件
# K8s/Docker 输出 stdout 时：LOG_FILE_ENABLED=False（忽略下面三项）
# LOG_FILE_MAX_BYTES 设为 0 表示不限制大小（不推荐）
# development → ConsoleRenderer 彩色输出
# staging     → JSONRenderer 机器解析
# production  → JSONRenderer 机器解析
